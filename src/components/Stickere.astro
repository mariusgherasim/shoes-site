---
// Stickerele plutitoare (reclame) + bara Trustpilot. Configurare:
//   src/data/stickere.js  — reclamele
//   src/data/site.js      — Trustpilot
import { STICKERE } from '../data/stickere.js';
import { TRUSTPILOT } from '../data/site.js';
import { produseColectie, maxReducere } from '../data/catalog.mjs';

const hot = produseColectie('ofertele-saptamanii');
const maxPct = maxReducere();

const lista = STICKERE.filter((s) => s.activ !== false).map((s) => {
  if (s.id !== 'hot-deals') return s;
  return {
    ...s,
    auto: true,
    mare: `-${maxPct}%`,
    eticheta: 'Hot<br>Deals',
    brand: `${hot.length.toLocaleString('ro-RO')} oferte`,
    text: 'Reduceri de peste 30%, actualizate',
    cta: 'Vezi Hot Deals',
    link: '/ofertele-saptamanii/',
    culoare: '#A8402F',
  };
}).filter((s) => s.id !== 'hot-deals' || hot.length > 0);

const tpWidget = !!TRUSTPILOT.businessUnitId;
---
{lista.map((s) => {
  const extern = /^https?:/.test(s.link);
  return (
    <a class={`stk stk-${s.pozitie === 'stanga' ? 'st' : 'dr'}`} id={`stk-${s.id}`} href={s.link}
       target={extern ? '_blank' : undefined} rel={extern ? 'noopener sponsored nofollow' : undefined}
       data-start={s.de_la || ''} data-end={s.pana_la || ''} data-auto={s.auto ? '1' : ''}
       style={`--stk:${s.culoare || '#A8402F'}`}>
      <div class="stk-top"><span class="stk-mare">{s.mare}</span><span class="stk-et" set:html={s.eticheta} /></div>
      <div class="stk-mid"><div class="stk-brand">{s.brand}</div><div class="stk-text">{s.text}</div></div>
      <div class="stk-timer">
        <div class="stk-b"><span class="stk-n" data-u="d">--</span><span class="stk-l">Zile</span></div><span class="stk-sep">:</span>
        <div class="stk-b"><span class="stk-n" data-u="h">--</span><span class="stk-l">Ore</span></div><span class="stk-sep">:</span>
        <div class="stk-b"><span class="stk-n" data-u="m">--</span><span class="stk-l">Min</span></div>
      </div>
      <div class="stk-cta">{s.cta} →</div>
      <button type="button" class="stk-x" aria-label="Închide">✕</button>
    </a>
  );
})}

<div id="tp-sticker">
  <button type="button" class="tp-close" id="tp-close" aria-label="Închide">✕</button>
  <div class="tp-sticker-label">Recenzii clienți</div>
  {tpWidget ? (
    <div class="trustpilot-widget" data-locale="ro-RO" data-template-id={TRUSTPILOT.templateId}
         data-businessunit-id={TRUSTPILOT.businessUnitId} data-style-height="52px" data-style-width="100%"
         data-token={TRUSTPILOT.token}>
      <a href={TRUSTPILOT.link} target="_blank" rel="noopener">Trustpilot</a>
    </div>
  ) : (
    <a class="tp-fallback" href={TRUSTPILOT.link} target="_blank" rel="noopener">
      <span class="tp-stars">★★★★★</span> Lasă-ne o recenzie pe <b>Trustpilot</b>
    </a>
  )}
</div>

<style is:global>
  .stk {
    position: fixed; bottom: 24px; z-index: 9999; width: 178px;
    background: var(--color-navy); color: #fff; border-radius: 10px; overflow: hidden; display: block;
    box-shadow: 0 8px 32px rgba(0,0,0,.28), 0 2px 8px rgba(184,134,58,.25);
    transition: transform .2s, box-shadow .2s, opacity .3s; font-family: var(--font-body);
  }
  .stk[hidden] { display: none; }
  .stk-dr { right: 24px; } .stk-st { left: 24px; }
  .stk:hover { transform: translateY(-3px); }
  .stk-top { background: var(--stk); padding: 10px 32px 8px 14px; display: flex; align-items: center; justify-content: space-between; }
  .stk-mare { font: 600 1.75rem/1 var(--font-display); }
  .stk-et { font-family: var(--font-mono); font-size: .6rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; text-align: right; line-height: 1.35; }
  .stk-mid { padding: 9px 14px 6px; border-bottom: 1px solid rgba(255,255,255,.1); }
  .stk-brand { font-family: var(--font-mono); font-size: .66rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--color-brass); margin-bottom: 3px; }
  .stk-text { font-size: .76rem; color: rgba(255,255,255,.8); line-height: 1.4; }
  .stk-timer { padding: 8px 12px; display: flex; gap: 5px; justify-content: center; align-items: center; }
  .stk-b { display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,.08); border-radius: 5px; padding: 4px 6px; min-width: 36px; }
  .stk-n { font-family: var(--font-mono); font-size: .9rem; font-weight: 600; line-height: 1; }
  .stk-l { font-size: .48rem; text-transform: uppercase; letter-spacing: .06em; color: rgba(255,255,255,.5); margin-top: 2px; }
  .stk-sep { font-size: .75rem; color: rgba(255,255,255,.3); }
  .stk-cta { background: var(--color-brass); text-align: center; padding: 9px 12px; font-family: var(--font-mono); font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
  .stk-x { position: absolute; top: 7px; right: 7px; width: 18px; height: 18px; padding: 0; border: 0; border-radius: 50%; background: rgba(0,0,0,.2); color: #fff; font-size: 10px; line-height: 1; cursor: pointer; }
  .stk-x:hover { background: rgba(0,0,0,.35); }

  #tp-sticker {
    position: fixed; left: 12px; top: 50%; transform: translateY(-50%); z-index: 9998;
    background: #fff; border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,.15);
    padding: 8px 26px 8px 12px; min-width: 200px; max-width: 240px;
  }
  #tp-sticker[hidden] { display: none !important; }
  .tp-close { position: absolute; top: 5px; right: 5px; width: 18px; height: 18px; padding: 0; border: 0; border-radius: 50%; background: rgba(0,0,0,.08); color: #555; font-size: 10px; line-height: 1; cursor: pointer; }
  .tp-sticker-label { font-family: var(--font-mono); font-size: .6rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--color-steel); margin-bottom: 4px; }
  .tp-fallback { font-size: .8rem; color: var(--color-ink); line-height: 1.35; display: block; }
  .tp-stars { color: #00b67a; letter-spacing: 1px; display: block; font-size: 1rem; }

  @media (max-width: 1599px) and (min-width: 641px) { #tp-sticker { top: auto; bottom: 24px; transform: none; left: 24px; } .stk-st { bottom: 120px; } }
  @media (max-width: 640px) {
    .stk { width: 136px; bottom: 74px; }
    .stk-dr { right: 10px; } .stk-st { left: 10px; }
    .stk-text, .stk-mid, .stk-timer { display: none; }
    .stk-top { padding: 8px 30px 6px 12px; }
    .stk-mare { font-size: 1.4rem; }
    #tp-sticker {
      top: auto; bottom: 0; left: 0; right: 0; transform: none; min-width: 0; max-width: none;
      border-radius: 12px 12px 0 0; padding: 6px 34px 6px 12px;
      display: flex; align-items: center; gap: 10px; box-shadow: 0 -4px 16px rgba(0,0,0,.12);
    }
    .tp-sticker-label { margin: 0; max-width: 70px; line-height: 1.3; }
    #tp-sticker .trustpilot-widget, .tp-fallback { flex: 1; min-width: 0; }
    .tp-stars { display: inline; font-size: .85rem; }
    .tp-close { top: 50%; right: 8px; transform: translateY(-50%); }
    body { padding-bottom: 64px; }
    html.tp-inchis .stk { bottom: 16px; }
    html.tp-inchis body { padding-bottom: 0; }
    .cookie-banner { bottom: 60px; }
    html.tp-inchis .cookie-banner { bottom: 0; }
  }
</style>

<script is:inline>
  (function () {
    var acum = new Date();
    function pad(n) { return String(n).padStart(2, '0'); }
    // Duminica aceasta, ora 23:59:59 (ora României) — pentru stickerul automat
    function duminica() {
      var d = new Date(acum); var zile = (7 - d.getDay()) % 7;
      d.setDate(d.getDate() + zile); d.setHours(23, 59, 59, 0); return d;
    }
    document.querySelectorAll('.stk').forEach(function (el) {
      var start = el.dataset.start ? new Date(el.dataset.start) : null;
      var end = el.dataset.auto ? duminica() : (el.dataset.end ? new Date(el.dataset.end) : null);
      if ((start && acum < start) || (end && acum > end)) { el.hidden = true; return; }
      if (el.getAttribute('href') && location.pathname === el.getAttribute('href')) { el.hidden = true; return; }
      var u = {}; el.querySelectorAll('[data-u]').forEach(function (n) { u[n.dataset.u] = n; });
      function tick() {
        if (!end) { el.querySelector('.stk-timer').hidden = true; return; }
        var diff = Math.max(0, end - new Date());
        u.d.textContent = pad(Math.floor(diff / 86400000)); diff %= 86400000;
        u.h.textContent = pad(Math.floor(diff / 3600000)); diff %= 3600000;
        u.m.textContent = pad(Math.floor(diff / 60000));
      }
      tick(); setInterval(tick, 30000);
      el.querySelector('.stk-x').addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation();
        el.style.opacity = '0'; setTimeout(function () { el.hidden = true; }, 300);
      });
    });
    // X la Trustpilot: ascunde doar pe pagina curentă
    var tp = document.getElementById('tp-close');
    if (tp) tp.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      document.getElementById('tp-sticker').hidden = true;
      document.documentElement.classList.add('tp-inchis');
    });
  })();
</script>
