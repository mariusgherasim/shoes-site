---
// Stickerele plutitoare (reclame) + bara Trustpilot. Configurare:
//   src/data/stickere.js  — reclamele
//   src/data/site.js      — Trustpilot
import { STICKERE } from '../data/stickere.js';
import { TRUSTPILOT } from '../data/site.js';
import { produseColectie, hotDealsPrimaPagina } from '../data/catalog.mjs';
import { MAGAZINE } from '../scripts/magazine.js';

const hot = produseColectie('ofertele-saptamanii');

// „Oferta zilei": până la 31 de Hot Deals (amestecate pe categorii). Browserul o alege
// pe cea de azi după dată, deci se schimbă singură la miezul nopții, fără build nou.
const scurt = (t, n = 58) => (t.length > n ? t.slice(0, n).trim() + '…' : t);
const vazute = new Set();
const ofZi = hotDealsPrimaPagina(60)
  .filter((p) => p.image_url && p.discount_percent >= 30 && !vazute.has(p.title) && vazute.add(p.title))
  .slice(0, 31)
  .map((p) => ({
    t: scurt(p.title), b: p.brandName || p.brand || '', m: MAGAZINE[p.source_site] || p.source_site,
    pr: p.price, op: p.old_price, pct: p.discount_percent, img: p.image_url, u: p.affiliate_url,
  }));

const lista = STICKERE.filter((s) => s.activ !== false).map((s) => {
  if (s.id !== 'hot-deals') return s;
  return { ...s, zi: true, culoare: '#A8402F', link: '/ofertele-saptamanii/' };
}).filter((s) => s.id !== 'hot-deals' || ofZi.length > 0);

const tpWidget = !!TRUSTPILOT.businessUnitId;
---
{lista.map((s) => {
  const extern = /^https?:/.test(s.link);
  if (s.zi) return (
    <a class={`stk stk-zi stk-${s.pozitie === 'stanga' ? 'st' : 'dr'}`} id="stk-hot-deals" href={s.link}
       target="_blank" rel="noopener sponsored nofollow" style={`--stk:${s.culoare}`}
       data-oferte={JSON.stringify(ofZi)} data-total={hot.length}>
      <div class="stk-top"><span class="stk-mare" data-z="pct">-%</span><span class="stk-et">Oferta<br>zilei</span></div>
      <div class="stk-img"><img data-z="img" alt="" width="150" height="110" loading="lazy" /></div>
      <div class="stk-mid">
        <div class="stk-brand" data-z="b"></div>
        <div class="stk-text" data-z="t"></div>
        <div class="stk-pret"><b data-z="pr"></b><s data-z="op"></s><span class="stk-mag">la <span data-z="m"></span></span></div>
      </div>
      <div class="stk-timer stk-timer-s" aria-label="Timp rămas până la miezul nopții">
        <div class="stk-b"><span class="stk-n" data-u="h">--</span><span class="stk-l">Ore</span></div><span class="stk-sep">:</span>
        <div class="stk-b"><span class="stk-n" data-u="m">--</span><span class="stk-l">Min</span></div><span class="stk-sep">:</span>
        <div class="stk-b"><span class="stk-n" data-u="s">--</span><span class="stk-l">Sec</span></div>
      </div>
      <div class="stk-cta">Vezi oferta →</div>
      <button type="button" class="stk-x" aria-label="Închide">✕</button>
    </a>
  );
  return (
    <a class={`stk stk-${s.pozitie === 'stanga' ? 'st' : 'dr'}`} id={`stk-${s.id}`} href={s.link}
       target={extern ? '_blank' : undefined} rel={extern ? 'noopener sponsored nofollow' : undefined}
       data-start={s.de_la || ''} data-end={s.pana_la || ''} data-auto={s.auto ? '1' : ''}
       data-faze={s.faze ? JSON.stringify(s.faze) : undefined} data-valuri={s.valuri ? JSON.stringify(s.valuri) : undefined}
       style={`--stk:${s.culoare || '#A8402F'}`}>
      <div class="stk-top"><span class="stk-mare">{s.mare}</span><span class="stk-et" set:html={s.eticheta} /></div>
      <div class="stk-mid"><div class="stk-brand">{s.brand}</div><div class="stk-text">{s.text}</div></div>
      {s.faze && <div class="stk-tl">&nbsp;</div>}
      <div class="stk-timer">
        <div class="stk-b"><span class="stk-n" data-u="d">--</span><span class="stk-l">Zile</span></div><span class="stk-sep">:</span>
        <div class="stk-b"><span class="stk-n" data-u="h">--</span><span class="stk-l">Ore</span></div><span class="stk-sep">:</span>
        <div class="stk-b"><span class="stk-n" data-u="m">--</span><span class="stk-l">Min</span></div>
      </div>
      <div class="stk-cta">{s.cta} →</div>
      <button type="button" class="stk-x" aria-label="Închide">✕</button>
    </a>
  );
})}

<div id="tp-sticker">
  <button type="button" class="tp-close" id="tp-close" aria-label="Închide">✕</button>
  <div class="tp-sticker-label">Recenzii clienți</div>
  {tpWidget ? (
    <div class="trustpilot-widget" data-locale="ro-RO" data-template-id={TRUSTPILOT.templateId}
         data-businessunit-id={TRUSTPILOT.businessUnitId} data-style-height="52px" data-style-width="100%"
         data-token={TRUSTPILOT.token}>
      <a href={TRUSTPILOT.link} target="_blank" rel="noopener">Trustpilot</a>
    </div>
  ) : (
    <a class="tp-fallback" href={TRUSTPILOT.link} target="_blank" rel="noopener">
      <span class="tp-stars">★★★★★</span> Lasă-ne o recenzie pe <b>Trustpilot</b>
    </a>
  )}
</div>

<style is:global>
  .stk {
    position: fixed; bottom: 24px; z-index: 9999; width: 178px;
    background: var(--color-navy); color: #fff; border-radius: 10px; overflow: hidden; display: block;
    box-shadow: 0 8px 32px rgba(0,0,0,.28), 0 2px 8px rgba(184,134,58,.25);
    transition: transform .2s, box-shadow .2s, opacity .3s; font-family: var(--font-body);
  }
  .stk[hidden] { display: none; }
  .stk-dr { right: 24px; } .stk-st { left: 24px; }
  .stk:hover { transform: translateY(-3px); }
  .stk-top { background: var(--stk); padding: 10px 32px 8px 14px; display: flex; align-items: center; justify-content: space-between; }
  .stk-mare { font: 600 1.75rem/1 var(--font-display); }
  .stk-et { font-family: var(--font-mono); font-size: .6rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; text-align: right; line-height: 1.35; }
  .stk-mid { padding: 9px 14px 6px; border-bottom: 1px solid rgba(255,255,255,.1); }
  .stk-brand { font-family: var(--font-mono); font-size: .66rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--color-brass); margin-bottom: 3px; }
  .stk-text { font-size: .76rem; color: rgba(255,255,255,.8); line-height: 1.4; }
  .stk-timer { padding: 8px 12px; display: flex; gap: 5px; justify-content: center; align-items: center; }
  .stk-b { display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,.08); border-radius: 5px; padding: 4px 6px; min-width: 36px; }
  .stk-n { font-family: var(--font-mono); font-size: .9rem; font-weight: 600; line-height: 1; }
  .stk-l { font-size: .48rem; text-transform: uppercase; letter-spacing: .06em; color: rgba(255,255,255,.5); margin-top: 2px; }
  .stk-sep { font-size: .75rem; color: rgba(255,255,255,.3); }
  .stk-tl { padding: 7px 12px 0; text-align: center; font-family: var(--font-mono); font-size: .56rem; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.55); }
  .stk-val { display: block; margin-top: 4px; color: var(--color-brass); font-weight: 600; }
  .stk-cta { background: var(--color-brass); text-align: center; padding: 9px 12px; font-family: var(--font-mono); font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
  .stk-img { background: #fff; height: 96px; display: flex; align-items: center; justify-content: center; padding: 6px; }
  .stk-img img { max-width: 100%; max-height: 84px; object-fit: contain; font-size: 0; }
  .stk-zi .stk-text { color: #fff; font-weight: 600; font-size: .74rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .stk-pret { margin-top: 5px; font-family: var(--font-mono); font-size: .82rem; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 6px; }
  .stk-pret s { color: rgba(255,255,255,.5); font-size: .66rem; }
  .stk-mag { flex-basis: 100%; font-size: .6rem; color: rgba(255,255,255,.5); text-transform: uppercase; letter-spacing: .06em; margin-top: 2px; }
  .stk-pret b { color: var(--color-brass); }
  .stk-zi .stk-n[data-u="s"] { color: var(--color-brass); }
  .stk-x { position: absolute; top: 7px; right: 7px; width: 18px; height: 18px; padding: 0; border: 0; border-radius: 50%; background: rgba(0,0,0,.2); color: #fff; font-size: 10px; line-height: 1; cursor: pointer; }
  .stk-x:hover { background: rgba(0,0,0,.35); }

  #tp-sticker {
    position: fixed; left: 12px; top: 50%; transform: translateY(-50%); z-index: 9998;
    background: #fff; border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,.15);
    padding: 8px 26px 8px 12px; min-width: 200px; max-width: 240px;
  }
  #tp-sticker[hidden] { display: none !important; }
  .tp-close { position: absolute; top: 5px; right: 5px; width: 18px; height: 18px; padding: 0; border: 0; border-radius: 50%; background: rgba(0,0,0,.08); color: #555; font-size: 10px; line-height: 1; cursor: pointer; }
  .tp-sticker-label { font-family: var(--font-mono); font-size: .6rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--color-steel); margin-bottom: 4px; }
  .tp-fallback { font-size: .8rem; color: var(--color-ink); line-height: 1.35; display: block; }
  .tp-stars { color: #00b67a; letter-spacing: 1px; display: block; font-size: 1rem; }

  @media (max-width: 1599px) and (min-width: 641px) { #tp-sticker { top: auto; bottom: 24px; transform: none; left: 24px; } .stk-st { bottom: 120px; } }
  @media (max-width: 640px) {
    .stk { width: 136px; bottom: 74px; }
    .stk-dr { right: 10px; } .stk-st { left: 10px; }
    .stk-text, .stk-mid, .stk-timer, .stk-tl { display: none; }
    .stk-zi .stk-img { height: 74px; } .stk-zi .stk-img img { max-height: 66px; }
    .stk-zi .stk-timer-s { display: flex; padding: 5px 6px; gap: 3px; }
    .stk-zi .stk-b { min-width: 28px; padding: 3px 4px; } .stk-zi .stk-l { display: none; }
    .stk-zi .stk-cta { font-size: .6rem; padding: 7px 6px; }
    .stk-top { padding: 8px 30px 6px 12px; }
    .stk-mare { font-size: 1.4rem; }
    #tp-sticker {
      top: auto; bottom: 0; left: 0; right: 0; transform: none; min-width: 0; max-width: none;
      border-radius: 12px 12px 0 0; padding: 6px 34px 6px 12px;
      display: flex; align-items: center; gap: 10px; box-shadow: 0 -4px 16px rgba(0,0,0,.12);
    }
    .tp-sticker-label { margin: 0; max-width: 70px; line-height: 1.3; }
    #tp-sticker .trustpilot-widget, .tp-fallback { flex: 1; min-width: 0; }
    .tp-stars { display: inline; font-size: .85rem; }
    .tp-close { top: 50%; right: 8px; transform: translateY(-50%); }
    body { padding-bottom: 64px; }
    html.tp-inchis .stk { bottom: 16px; }
    html.tp-inchis body { padding-bottom: 0; }
    .cookie-banner { bottom: 60px; }
    html.tp-inchis .cookie-banner { bottom: 0; }
  }
</style>

<script is:inline>
  (function () {
    var acum = new Date();
    function pad(n) { return String(n).padStart(2, '0'); }
    // Duminica aceasta, ora 23:59:59 (ora României) — pentru stickerul automat
    function duminica() {
      var d = new Date(acum); var zile = (7 - d.getDay()) % 7;
      d.setDate(d.getDate() + zile); d.setHours(23, 59, 59, 0); return d;
    }
    // Ora României, ca oferta și cronometrul să se schimbe la miezul nopții în România
    function oraRo() {
      var f = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Bucharest', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
      var o = {}; f.formatToParts(new Date()).forEach(function (p) { o[p.type] = p.value; });
      return { zi: Date.UTC(+o.year, +o.month - 1, +o.day) / 86400000, sec: (+o.hour % 24) * 3600 + (+o.minute) * 60 + (+o.second) };
    }
    var zi = document.querySelector('.stk-zi');
    if (zi) {
      var lista = []; try { lista = JSON.parse(zi.dataset.oferte || '[]'); } catch (e) {}
      if (!lista.length) zi.hidden = true;
      else {
        var lei = function (n) { return Number(n).toLocaleString('ro-RO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' lei'; };
        var z = {}; zi.querySelectorAll('[data-z]').forEach(function (n) { z[n.dataset.z] = n; });
        var p = lista[oraRo().zi % lista.length];
        z.pct.textContent = '-' + p.pct + '%'; z.b.textContent = p.b; z.t.textContent = p.t; z.m.textContent = p.m;
        z.op.textContent = lei(p.op); z.pr.textContent = lei(p.pr); z.img.src = p.img; z.img.alt = p.t;
        zi.href = p.u;
        var uz = {}; zi.querySelectorAll('[data-u]').forEach(function (n) { uz[n.dataset.u] = n; });
        var tickZi = function () {
          var r = 86400 - oraRo().sec;
          uz.h.textContent = pad(Math.floor(r / 3600)); uz.m.textContent = pad(Math.floor(r % 3600 / 60)); uz.s.textContent = pad(r % 60);
        };
        tickZi(); setInterval(tickZi, 1000);
        zi.addEventListener('click', function () { if (typeof gtag === 'function') gtag('event', 'oferta_zilei_click', { produs: p.t, magazin: p.m }); });
        zi.querySelector('.stk-x').addEventListener('click', function (e) {
          e.preventDefault(); e.stopPropagation();
          zi.style.opacity = '0'; setTimeout(function () { zi.hidden = true; }, 300);
        });
      }
    }
    var ZILE = ['duminică', 'luni', 'marți', 'miercuri', 'joi', 'vineri', 'sâmbătă'];
    // ora și ziua unui moment, în ora României
    function ro(d) {
      var f = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Bucharest', weekday: 'short', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });
      var o = {}; f.formatToParts(d).forEach(function (p) { o[p.type] = p.value; });
      return { zi: o.year + o.month + o.day, ora: o.hour + ':' + o.minute, wd: ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].indexOf(o.weekday) };
    }
    function cand(d) {
      var a = ro(new Date()), b = ro(d), m = ro(new Date(Date.now() + 864e5));
      return (a.zi === b.zi ? 'azi' : m.zi === b.zi ? 'mâine' : ZILE[b.wd]) + ', ' + b.ora;
    }
    document.querySelectorAll('.stk:not(.stk-zi)').forEach(function (el) {
      var start = el.dataset.start ? new Date(el.dataset.start) : null;
      var end = el.dataset.auto ? duminica() : (el.dataset.end ? new Date(el.dataset.end) : null);
      if (el.dataset.faze && location.pathname.indexOf('/black-friday/') === 0) { el.hidden = true; return; } // pagina are deja cronometrul ei
      if (el.dataset.faze) {
        // sticker cu faze: alegem faza de acum și, dacă are valuri, ținta e următorul val.
        // La ora țintei recalculăm singuri (fără reîncărcarea paginii).
        var faze = JSON.parse(el.dataset.faze), valuri = (el.dataset.valuri ? JSON.parse(el.dataset.valuri) : []).map(function (v) { return new Date(v); });
        var q = function (c) { return el.querySelector(c); };
        var seteaza = function () {
          var n = new Date(), f = null;
          for (var i = 0; i < faze.length; i++) { if (n < new Date(faze[i].pana_la)) { f = faze[i]; break; } }
          if (!f) { el.hidden = true; end = null; return false; }
          end = new Date(f.pana_la);
          var schimba = end; // când trecem în faza următoare
          if (f.numara_pana) end = new Date(f.numara_pana);
          q('.stk-mare').textContent = f.mare; q('.stk-et').innerHTML = f.eticheta; q('.stk-cta').textContent = f.cta + ' →';
          var tl = q('.stk-tl'), txt = f.text;
          if (f.valuri) {
            var urm = valuri.filter(function (v) { return v > n; })[0];
            if (urm) {
              end = urm;
              txt = f.text + (urm - n <= 45 * 60000 ? ' Coada pentru val e deschisă!' : '');
              tl.innerHTML = f.timer + '<span class="stk-val">Val Best Deals: ' + cand(urm) + '</span>';
            } else { txt = f.text_final || f.text; tl.textContent = f.timer_final || f.timer; }
          } else tl.textContent = f.timer;
          q('.stk-text').textContent = txt;
          // reverificăm la următoarea schimbare (sau peste 45 min înainte de val, pentru mesajul cu coada)
          var urmator = Math.min(end, schimba) - n, coadaIn = f.valuri ? urmator - 45 * 60000 : 0;
          setTimeout(seteaza, Math.min(coadaIn > 0 ? coadaIn + 1000 : urmator + 1000, 2147483000));
          return true;
        };
        if (!seteaza()) return;
      }
      if ((start && acum < start) || (end && acum > end)) { el.hidden = true; return; }
      if (el.getAttribute('href') && location.pathname === el.getAttribute('href')) { el.hidden = true; return; }
      var u = {}; el.querySelectorAll('[data-u]').forEach(function (n) { u[n.dataset.u] = n; });
      function tick() {
        if (!end) { el.querySelector('.stk-timer').hidden = true; return; }
        var diff = Math.max(0, end - new Date());
        u.d.textContent = pad(Math.floor(diff / 86400000)); diff %= 86400000;
        u.h.textContent = pad(Math.floor(diff / 3600000)); diff %= 3600000;
        u.m.textContent = pad(Math.floor(diff / 60000));
      }
      tick(); setInterval(tick, 30000);
      el.querySelector('.stk-x').addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation();
        el.style.opacity = '0'; setTimeout(function () { el.hidden = true; }, 300);
      });
    });
    // X la Trustpilot: ascunde doar pe pagina curentă
    var tp = document.getElementById('tp-close');
    if (tp) tp.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      document.getElementById('tp-sticker').hidden = true;
      document.documentElement.classList.add('tp-inchis');
    });
  })();
</script>
