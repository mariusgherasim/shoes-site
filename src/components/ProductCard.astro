---
// Cardul de produs (aspect shop). Varianta generată în browser este în
// src/scripts/card.js — cele două trebuie să rămână identice.
import { magazin } from '../scripts/magazine.js';
const { product: p } = Astro.props;
const hot = p.discount_percent != null && p.discount_percent > 30;
const brand = p.brandName || p.brand;
---
<a
  class="product-card"
  href={p.affiliate_url}
  target="_blank"
  rel="sponsored nofollow noopener"
  aria-label={`${p.title} — vezi oferta, ${p.price} lei`}
  data-product-id={p.id}
  data-brand={brand}
  data-title={p.title}
  data-price={p.price}
>
  {hot && (
    <span class="hot-deal-badge" aria-label="Hot Deal">
      <svg viewBox="0 0 56 64" width="56" height="64" xmlns="http://www.w3.org/2000/svg">
        <path d="M28 2 C18 14 10 20 12 34 C14 46 22 54 28 58 C34 54 42 46 44 34 C46 20 38 14 28 2Z" fill="#E8492C"/>
        <path d="M28 16 C22 24 20 30 22 38 C24 44 26 48 28 52 C30 48 32 44 34 38 C36 30 34 24 28 16Z" fill="#F7A034"/>
        <text x="28" y="36" text-anchor="middle" font-family="Arial Black, sans-serif" font-size="8" font-weight="900" fill="#fff" letter-spacing="0.5">HOT</text>
        <text x="28" y="46" text-anchor="middle" font-family="Arial Black, sans-serif" font-size="7" font-weight="900" fill="#fff" letter-spacing="0.5">DEAL</text>
      </svg>
    </span>
  )}
  {p.discount_percent ? <span class="seal">-{p.discount_percent}%</span> : null}
  <div class="thumb">
    {p.image_url && <img src={p.image_url} alt={p.title} loading="lazy" referrerpolicy="no-referrer" />}
  </div>
  <div class="body">
    {brand ? <span class="brand">{brand}</span> : null}
    <h3>{p.title}</h3>
    <div class="price-row">
      {p.old_price ? <span class="old-price">{p.old_price.toFixed(2)} Lei</span> : null}
      <span class="price-btn">{p.price.toFixed(2)} Lei</span>
    </div>
    <span class="shop-src">la {magazin(p.source_site)}</span>
  </div>
</a>
