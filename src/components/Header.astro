---
import { categorii } from '../data/categorii.js';
const n = (slug) => categorii.find((c) => c.slug === slug)?.name;
// Meniul principal: unele intrări grupează mai multe categorii
const MENIU = [
  { label: 'Ceasuri', href: '/ceasuri/', sub: [['Toate ceasurile', '/ceasuri/'], ['Ceasuri bărbătești', '/ceasuri/tip/barbatesti/'], ['Ceasuri damă', '/ceasuri/tip/dama/'], ['Smartwatch', '/ceasuri/tip/smartwatch/'], ['Gravură personalizată', '/gravura-personalizata/']] },
  { label: 'Ochelari', href: '/ochelari-de-soare/', sub: [[n('ochelari-de-soare'), '/ochelari-de-soare/'], [n('rame-ochelari'), '/rame-ochelari/']] },
  { label: 'Bijuterii', href: '/bijuterii/' },
  { label: 'Încălțăminte', href: '/incaltaminte-femei/', sub: [['Femei', '/incaltaminte-femei/'], ['Bărbați', '/incaltaminte-barbati/'], ['Copii', '/incaltaminte-copii/']] },
  { label: 'Îmbrăcăminte', href: '/imbracaminte/', sub: [['Toată îmbrăcămintea', '/imbracaminte/'], ['Rochii', '/imbracaminte/tip/rochii/'], ['Bluze & topuri damă', '/imbracaminte/tip/bluze-topuri/'], ['Fuste', '/imbracaminte/tip/fuste/'], ['Tricouri & polo', '/imbracaminte/tip/tricouri/'], ['Cămăși', '/imbracaminte/tip/camasi/'], ['Geci & paltoane', '/imbracaminte/tip/geci-paltoane/']] },
  { label: 'Genți & accesorii', href: '/genti-accesorii/' },
  { label: 'Cadouri', href: '/cadouri-pentru-ea/', sub: [['Cadouri pentru ea', '/cadouri-pentru-ea/'], ['Cadouri pentru el', '/cadouri-pentru-el/'], ['Sub 150 lei', '/sub-150-lei/'], ['Sub 300 lei', '/sub-300-lei/'], ['Noutăți', '/noutati/']] },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container">
    <a href="/" class="wordmark" aria-label="style.accessories — prima pagină">
      <img src="/brand/logo-alb.svg" alt="style.accessories" width="210" height="26" />
    </a>
    <button class="nav-toggle" aria-label="Deschide meniul" aria-expanded="false" aria-controls="main-nav">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </button>
    <nav class="main-nav" id="main-nav">
      {MENIU.map((m) => (
        <div class="nav-item">
          <a href={m.href} aria-current={path.startsWith(m.href) ? 'page' : undefined}>{m.label}{m.sub && <span aria-hidden="true">▾</span>}</a>
          {m.sub && (
            <div class="sub">
              {m.sub.map(([l, h]) => <a href={h}>{l}</a>)}
            </div>
          )}
        </div>
      ))}
      <a href="/oferte/" class="nav-oferte" aria-current={path.startsWith('/oferte') ? 'page' : undefined}>🔥 Oferte</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = nav.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (nav?.classList.contains('is-open') && !nav.contains(e.target)) {
      nav.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
</script>
