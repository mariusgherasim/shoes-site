---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
import banners from '../../data/banners.json';
import { SUBCATEGORIES } from '../../data/subcategories.js';

const PER_PAGE = 24;

export async function getStaticPaths() {
  const PER_PAGE = 24;
  const active = products.filter(p => !p.draft && p.availability);
  const paths = [];
  const assigned = new Set();

  for (const subcat of SUBCATEGORIES) {
    const items = [];
    for (const prod of active) {
      if (!assigned.has(prod.id)) {
        try {
          if (subcat.rule(prod)) {
            items.push(prod);
            assigned.add(prod.id);
          }
        } catch(e) {}
      }
    }

    const totalPages = Math.max(1, Math.ceil(items.length / PER_PAGE));
    for (let page = 1; page <= totalPages; page++) {
      paths.push({
        params: { subcategorie: subcat.slug, p: String(page) },
        props: { subcat, items, totalPages },
      });
    }
  }
  return paths;
}

const { subcategorie, p } = Astro.params;
const { subcat, items, totalPages } = Astro.props;
const currentPage = parseInt(p);
const pageItems = items.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);

// Fereastra paginare — un singur bloc, 9 numere max
const MAX_PAGES = 9;
const half = Math.floor(MAX_PAGES / 2);
let winStart = Math.max(1, currentPage - half);
let winEnd = winStart + MAX_PAGES - 1;
if (winEnd > totalPages) {
  winEnd = totalPages;
  winStart = Math.max(1, winEnd - MAX_PAGES + 1);
}
const pageWindow = Array.from({ length: winEnd - winStart + 1 }, (_, i) => winStart + i);
const showLeftEllipsis = pageWindow[0] > 1;
const showRightEllipsis = pageWindow[pageWindow.length - 1] < totalPages;

const today = new Date().toISOString().split('T')[0];
const activeBanners = banners.filter(b =>
  b.active &&
  (!b.startDate || b.startDate <= today) &&
  (!b.endDate || b.endDate >= today)
);

const canonical = currentPage === 1
  ? `https://style.gherasimmarius.com/${subcategorie}`
  : `https://style.gherasimmarius.com/${subcategorie}/${p}`;

const pageTitle = currentPage > 1
  ? `${subcat.metaTitle} — Pagina ${currentPage}`
  : subcat.metaTitle;
---

<Layout title={pageTitle} description={subcat.metaDescription} canonical={canonical}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": subcat.title,
    "description": subcat.description,
    "url": `https://style.gherasimmarius.com/${subcategorie}`,
    "numberOfItems": items.length,
  })} />

  <div class="page-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Acasă</a>
      <span>›</span>
      {subcat.parentSlug && <a href={`/${subcat.parentSlug}/1`}>{subcat.parentSlug === 'femei' ? 'Femei' : 'Bărbați'}</a>}
      {subcat.parentSlug && <span>›</span>}
      <span>{subcat.label}</span>
    </nav>
    <h1>{subcat.title}</h1>
    <p>{subcat.description}</p>
  </div>

  {activeBanners.map(b => (
    <div class="promo-banner">
      <div class="banner-text">
        <h2>{b.title}</h2>
        <p>{b.subtitle}</p>
      </div>
      <a href={b.url} class="banner-cta">{b.cta}</a>
    </div>
  ))}

  <div class="filters-bar">
    <span class="filter-count">{items.length} produse</span>
  </div>

  <div class="product-grid">
    {pageItems.map(prod => <ProductCard product={prod} />)}
  </div>

  {totalPages > 1 && (
    <nav class="pagination" aria-label="Paginare">
      <div class="pagination-info">Pagina {currentPage} din {totalPages}</div>
      <div class="pagination-controls">

        {currentPage > 1
          ? <a href={`/${subcategorie}/1`} class="page-link page-edge" title="Prima pagină">«</a>
          : <span class="page-link page-edge disabled">«</span>}

        {currentPage > 1
          ? <a href={`/${subcategorie}/${currentPage - 1}`} class="page-link page-arrow">‹</a>
          : <span class="page-link page-arrow disabled">‹</span>}

        {showLeftEllipsis && <span class="page-ellipsis">…</span>}
        {pageWindow.map(n => (
          <a
            href={`/${subcategorie}/${n}`}
            class={`page-link ${n === currentPage ? 'active' : ''}`}
            aria-current={n === currentPage ? 'page' : undefined}
          >{n}</a>
        ))}
        {showRightEllipsis && <span class="page-ellipsis">…</span>}

        {currentPage < totalPages
          ? <a href={`/${subcategorie}/${currentPage + 1}`} class="page-link page-arrow">›</a>
          : <span class="page-link page-arrow disabled">›</span>}

        {currentPage < totalPages
          ? <a href={`/${subcategorie}/${totalPages}`} class="page-link page-edge" title={`Ultima pagină (${totalPages})`}>»</a>
          : <span class="page-link page-edge disabled">»</span>}

      </div>
    </nav>
  )}

</Layout>
