---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Banner from '../components/Banner.astro';
import HomeSearch from '../components/HomeSearch.astro';
import { categorii } from '../data/categorii.js';
import { produse, oferte, produseCategorie, produseColectie, recomandate, amestecaPeCategorii, maxReducere, hotDealsPrimaPagina } from '../data/catalog.mjs';
import { niceCount } from '../data/text.mjs';

const total = produse.length;
const hot = produseColectie('ofertele-saptamanii');
const hotHome = hotDealsPrimaPagina(12);
const picks = recomandate(12);
const maxPct = maxReducere();
const fmt = (n) => n.toLocaleString('ro-RO');
const tiles = categorii.map((c) => {
  const l = produseCategorie(c.slug);
  return { ...c, count: l.length, deals: l.filter((p) => p.discount_percent).length, imgs: l.filter((p) => p.image_url).slice(0, 3) };
});
const totalRotunjit = niceCount(total).replace('peste ', '');
---
<Layout
  title="style.accessories — ceasuri, ochelari, bijuterii, încălțăminte și genți cu reduceri"
  description={`Peste ${totalRotunjit} de produse de la 7 magazine online: ceasuri, ochelari, bijuterii, încălțăminte, haine și genți. ${fmt(oferte.length)} au reducere acum.`}
>
  <section class="hero">
    <div class="hero-dial" aria-hidden="true"><span class="hero-sweep"></span></div>
    <div class="container">
      <p class="eyebrow">Ediția curentă · 7 magazine</p>
      <h1>Peste {totalRotunjit} de produse. De ce să plătești prețul întreg?</h1>
      <p class="lede">
        Ceasuri, ochelari, bijuterii, încălțăminte, haine și genți — {fmt(oferte.length)} au reducere chiar acum,
        unele de până la {maxPct}%. Cauți un model sau un brand? Începe aici.
      </p>
      <HomeSearch />
      <div class="hero-stats">
        <span><b>{fmt(total)}</b> produse</span>
        <span><b>{fmt(oferte.length)}</b> cu reducere</span>
        <span><b>{fmt(hot.length)}</b> Hot Deals peste 30%</span>
      </div>
    </div>
  </section>

  <section id="hs-results" hidden aria-live="polite"></section>

  <div class="container">
    <section class="section" style="padding-bottom: 0;">
      <div class="filters">
        {categorii.map((c) => <a class="filter-chip" href={`/${c.slug}/`}>{c.name}</a>)}
        <a class="filter-chip" href="/cadouri-pentru-ea/">Cadouri pentru ea</a>
        <a class="filter-chip" href="/cadouri-pentru-el/">Cadouri pentru el</a>
        <a class="filter-chip" href="/sub-150-lei/">Sub 150 lei</a>
        <a class="filter-chip" href="/sub-300-lei/">Sub 300 lei</a>
        <a class="filter-chip" href="/oferte/">Oferte</a>
      </div>
    </section>

    {hotHome.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>🔥 Oferta săptămânii</h2>
          <a href="/ofertele-saptamanii/" class="eyebrow">Toate cele {fmt(hot.length)} Hot Deals →</a>
        </div>
        <div class="product-grid">
          {hotHome.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}

    <Banner variant="hero" categorie="homepage" />

    {picks.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Recomandările curente</h2>
          <span class="eyebrow">Se schimbă zilnic</span>
        </div>
        <div class="product-grid">
          {picks.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}

    <section class="section">
      <div class="section-head">
        <h2>Categorii</h2>
        <a href="/oferte/" class="eyebrow">Toate ofertele →</a>
      </div>
      <div class="cat-grid">
        {tiles.map((c) => (
          <a class="cat-card" href={`/${c.slug}/`}>
            <h3>{c.name}</h3>
            <span class="count">{fmt(c.count)} produse</span>
            {c.deals > 0 && <span class="deal">{fmt(c.deals)} cu reducere</span>}
            <span class="imgs">{c.imgs.map((p) => <span><img src={p.image_url} alt="" loading="lazy" referrerpolicy="no-referrer" /></span>)}</span>
          </a>
        ))}
      </div>
    </section>

    <a href="/gravura-personalizata/" class="gravura-banner">
      <div>
        <span class="eyebrow">Serviciu WatchShop.ro</span>
        <h3 style="margin: 0.2rem 0;">Gravură personalizată — de la 100 lei</h3>
        <p style="margin: 0; color: var(--color-steel);">Numele lui, data voastră, un mesaj de iubire — gravat pe capacul ceasului.</p>
      </div>
      <span class="price-btn">Vezi detalii →</span>
    </a>

    <Banner variant="rectangle" categorie="homepage" />
  </div>
</Layout>
