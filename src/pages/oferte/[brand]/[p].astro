---
// src/pages/oferte/[brand]/[p].astro
// Pagini oferte per brand: /oferte/benvenuti/1, /oferte/gryxx/1 etc.
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import products from '../../../data/products.json';

const PER_PAGE = 24;

const BRANDS = {
  benvenuti: {
    source: 'benvenuti.com',
    label: 'Benvenuti',
    title: 'Oferte Benvenuti — Pantofi cu reducere',
    description: 'Toate produsele Benvenuti cu reducere activă, sortate după cel mai mare discount.',
    metaTitle: 'Oferte Benvenuti | style.gherasimmarius.com',
    metaDescription: 'Pantofi și accesorii Benvenuti cu reducere — cele mai mari discounturi zilnice.',
  },
  gryxx: {
    source: 'gryxx.ro',
    label: 'Gryxx',
    title: 'Oferte Gryxx — Încălțăminte cu reducere',
    description: 'Toate produsele Gryxx cu reducere activă, sortate după cel mai mare discount.',
    metaTitle: 'Oferte Gryxx | style.gherasimmarius.com',
    metaDescription: 'Încălțăminte Gryxx cu reducere — cele mai mari discounturi zilnice.',
  },
};

export async function getStaticPaths() {
  const PER_PAGE = 24;
  const paths = [];

  const BRANDS_STATIC = {
    benvenuti: 'benvenuti.com',
    gryxx: 'gryxx.ro',
  };

  for (const [brandSlug, sourceSlug] of Object.entries(BRANDS_STATIC)) {
    const items = products
      .filter(p =>
        !p.draft && p.availability &&
        p.source_site === sourceSlug &&
        p.old_price && p.old_price > p.price
      )
      .map(p => ({
        ...p,
        _pct: Math.round((1 - p.price / p.old_price) * 100),
      }))
      .sort((a, b) => b._pct - a._pct);

    const totalPages = Math.max(1, Math.ceil(items.length / PER_PAGE));

    for (let page = 1; page <= totalPages; page++) {
      paths.push({
        params: { brand: brandSlug, p: String(page) },
        props: { brandSlug, items, totalPages },
      });
    }
  }
  return paths;
}

const { brand: brandSlug, p } = Astro.params;
const { items, totalPages } = Astro.props;
const currentPage = parseInt(p);
const pageItems = items.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);
const brandInfo = BRANDS[brandSlug];

const MAX_PAGES = 9;
const half = Math.floor(MAX_PAGES / 2);
let winStart = Math.max(1, currentPage - half);
let winEnd = winStart + MAX_PAGES - 1;
if (winEnd > totalPages) { winEnd = totalPages; winStart = Math.max(1, winEnd - MAX_PAGES + 1); }
const pageWindow = Array.from({ length: winEnd - winStart + 1 }, (_, i) => winStart + i);
const showLeftEllipsis = pageWindow[0] > 1;
const showRightEllipsis = pageWindow[pageWindow.length - 1] < totalPages;

const canonicalBase = `https://style.gherasimmarius.com/oferte/${brandSlug}/`;
const canonical = currentPage === 1 ? canonicalBase : `${canonicalBase}${p}`;
---

<Layout
  title={currentPage > 1 ? `${brandInfo.metaTitle} — Pagina ${currentPage}` : brandInfo.metaTitle}
  description={brandInfo.metaDescription}
  canonical={canonical}
>
  <div class="page-header">
    <div class="brand-breadcrumb">
      <a href="/oferte/1">Oferte</a> <span>›</span> <span>{brandInfo.label}</span>
    </div>
    <h1>{brandInfo.title}</h1>
    <p>{brandInfo.description}</p>

    <div class="brand-switcher">
      <a href="/oferte/benvenuti/1" class={`brand-tab ${brandSlug === 'benvenuti' ? 'active' : ''}`}>
        Benvenuti
      </a>
      <a href="/oferte/gryxx/1" class={`brand-tab ${brandSlug === 'gryxx' ? 'active' : ''}`}>
        Gryxx
      </a>
      <a href="/oferte/1" class="brand-tab">Toate ofertele</a>
    </div>
  </div>

  <div class="filters-bar">
    <span class="filter-count">{items.length} produse cu reducere</span>
  </div>

  <div class="product-grid">
    {pageItems.map(p => <ProductCard product={p} />)}
  </div>

  {totalPages > 1 && (
    <nav class="pagination" aria-label="Paginare">
      <div class="pagination-info">Pagina {currentPage} din {totalPages}</div>
      <div class="pagination-controls">
        {currentPage > 1
          ? <a href={`/oferte/${brandSlug}/1`} class="page-link page-edge">«</a>
          : <span class="page-link page-edge disabled">«</span>}
        {currentPage > 1
          ? <a href={`/oferte/${brandSlug}/${currentPage - 1}`} class="page-link page-arrow">‹</a>
          : <span class="page-link page-arrow disabled">‹</span>}
        {showLeftEllipsis && <span class="page-ellipsis">…</span>}
        {pageWindow.map(n => (
          <a href={`/oferte/${brandSlug}/${n}`}
            class={`page-link ${n === currentPage ? 'active' : ''}`}
            aria-current={n === currentPage ? 'page' : undefined}>{n}</a>
        ))}
        {showRightEllipsis && <span class="page-ellipsis">…</span>}
        {currentPage < totalPages
          ? <a href={`/oferte/${brandSlug}/${currentPage + 1}`} class="page-link page-arrow">›</a>
          : <span class="page-link page-arrow disabled">›</span>}
        {currentPage < totalPages
          ? <a href={`/oferte/${brandSlug}/${totalPages}`} class="page-link page-edge">»</a>
          : <span class="page-link page-edge disabled">»</span>}
      </div>
    </nav>
  )}
</Layout>

<style>
  .brand-breadcrumb { font-size: 0.85rem; color: #888; margin-bottom: 8px; }
  .brand-breadcrumb a { color: #888; text-decoration: none; }
  .brand-breadcrumb a:hover { color: #333; }

  .brand-switcher {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .brand-tab {
    padding: 6px 16px;
    border-radius: 20px;
    border: 1px solid #ddd;
    text-decoration: none;
    font-size: 0.875rem;
    color: #555;
    background: #fff;
    transition: all 0.15s;
  }
  .brand-tab:hover { border-color: #333; color: #333; }
  .brand-tab.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }

  .pagination {
    display: flex; flex-direction: column; align-items: center;
    gap: 12px; padding: 32px 16px;
  }
  .pagination-info { font-size: 0.85rem; color: #888; }
  .pagination-controls {
    display: flex; align-items: center; gap: 4px;
    flex-wrap: wrap; justify-content: center; max-width: 100%;
  }
  .page-link {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 36px; height: 36px; padding: 0 8px; border-radius: 6px;
    font-size: 0.875rem; text-decoration: none; color: #333;
    border: 1px solid #e0e0e0; background: #fff; transition: all 0.15s;
  }
  .page-link:hover:not(.disabled):not(.active) { border-color: #333; background: #f5f5f5; }
  .page-link.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; font-weight: 600; }
  .page-link.disabled { opacity: 0.35; cursor: not-allowed; }
  .page-ellipsis { padding: 0 4px; color: #999; font-size: 0.875rem; }
  @media (max-width: 480px) {
    .page-link:not(.page-edge):not(.page-arrow):not(.active) { display: none; }
  }
</style>
