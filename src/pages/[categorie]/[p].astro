---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
import banners from '../../data/banners.json';
import { MANUAL_CATEGORIES, AUTO_COLLECTIONS } from '../../data/categories.js';

const PER_PAGE = 24;

export async function getStaticPaths() {
  const PER_PAGE = 24;
  const active = products.filter(p => !p.draft && p.availability);
  const allCats = [...MANUAL_CATEGORIES, ...AUTO_COLLECTIONS];
  const paths = [];

  for (const cat of allCats) {
    let items;
    if (cat.filter) {
      items = active.filter(cat.filter);
    } else {
      items = active.filter(p => p.category.includes(cat.slug));
    }
    const totalPages = Math.max(1, Math.ceil(items.length / PER_PAGE));

    for (let page = 1; page <= totalPages; page++) {
      paths.push({
        params: { categorie: cat.slug, p: String(page) },
        props: { cat, items, totalPages },
      });
    }
  }
  return paths;
}

const { categorie, p } = Astro.params;
const { cat, items, totalPages } = Astro.props;
const currentPage = parseInt(p);
const pageItems = items.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);

// Fereastra paginare — un singur bloc responsive (5 pe mobil, 9 pe desktop via CSS)
const MAX_PAGES = 9;
const half = Math.floor(MAX_PAGES / 2);
let winStart = Math.max(1, currentPage - half);
let winEnd = winStart + MAX_PAGES - 1;
if (winEnd > totalPages) {
  winEnd = totalPages;
  winStart = Math.max(1, winEnd - MAX_PAGES + 1);
}
const pageWindow = Array.from({ length: winEnd - winStart + 1 }, (_, i) => winStart + i);
const showLeftEllipsis = pageWindow[0] > 1;
const showRightEllipsis = pageWindow[pageWindow.length - 1] < totalPages;

// Bannere active
const today = new Date().toISOString().split('T')[0];
const activeBanners = banners.filter(b =>
  b.active &&
  (!b.startDate || b.startDate <= today) &&
  (!b.endDate || b.endDate >= today)
);

const canonical = currentPage === 1
  ? `https://style.gherasimmarius.com/${categorie}`
  : `https://style.gherasimmarius.com/${categorie}/${p}`;

const pageTitle = currentPage > 1
  ? `${cat.metaTitle} — Pagina ${currentPage}`
  : cat.metaTitle;
---

<Layout title={pageTitle} description={cat.metaDescription} canonical={canonical}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": cat.title,
    "description": cat.description,
    "url": `https://style.gherasimmarius.com/${categorie}`,
    "numberOfItems": items.length,
  })} />

  <div class="page-header">
    <h1>{cat.title}</h1>
    <p>{cat.description}</p>
  </div>

  {activeBanners.map(b => (
    <div class="promo-banner">
      <div class="banner-text">
        <h2>{b.title}</h2>
        <p>{b.subtitle}</p>
      </div>
      <a href={b.url} class="banner-cta">{b.cta}</a>
    </div>
  ))}

  <div class="filters-bar">
    <span class="filter-count">{items.length} produse</span>
  </div>

  <div class="product-grid">
    {pageItems.map(p => <ProductCard product={p} />)}
  </div>

  {totalPages > 1 && (
    <nav class="pagination" aria-label="Paginare">
      <div class="pagination-info">
        Pagina {currentPage} din {totalPages}
      </div>

      <div class="pagination-controls">
        {/* Prima pagina */}
        {currentPage > 1
          ? <a href={`/${categorie}/1`} class="page-link page-edge" title="Prima pagină">«</a>
          : <span class="page-link page-edge disabled">«</span>
        }

        {/* Pagina anterioara */}
        {currentPage > 1
          ? <a href={`/${categorie}/${currentPage - 1}`} class="page-link page-arrow">‹</a>
          : <span class="page-link page-arrow disabled">‹</span>
        }

        {/* Fereastra numere — un singur set, CSS controleaza cate se vad */}
        {showLeftEllipsis && <span class="page-ellipsis">…</span>}
        {pageWindow.map(n => (
          <a
            href={`/${categorie}/${n}`}
            class={`page-link ${n === currentPage ? 'active' : ''}`}
            aria-current={n === currentPage ? 'page' : undefined}
          >{n}</a>
        ))}
        {showRightEllipsis && <span class="page-ellipsis">…</span>}

        {/* Pagina urmatoare */}
        {currentPage < totalPages
          ? <a href={`/${categorie}/${currentPage + 1}`} class="page-link page-arrow">›</a>
          : <span class="page-link page-arrow disabled">›</span>
        }

        {/* Ultima pagina */}
        {currentPage < totalPages
          ? <a href={`/${categorie}/${totalPages}`} class="page-link page-edge" title={`Ultima pagină (${totalPages})`}>»</a>
          : <span class="page-link page-edge disabled">»</span>
        }
      </div>
    </nav>
  )}

</Layout>

<style>
  .pagination {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 32px 16px;
  }

  .pagination-info {
    font-size: 0.85rem;
    color: #888;
  }

  .pagination-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 100%;
  }

  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border-radius: 6px;
    font-size: 0.875rem;
    text-decoration: none;
    color: #333;
    border: 1px solid #e0e0e0;
    background: #fff;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .page-link:hover:not(.disabled):not(.active) {
    border-color: #333;
    background: #f5f5f5;
  }

  .page-link.active {
    background: #1a1a1a;
    color: #fff;
    border-color: #1a1a1a;
    font-weight: 600;
  }

  .page-link.disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .page-edge, .page-arrow {
    font-size: 1.1rem;
    font-weight: 500;
  }

  .page-ellipsis {
    padding: 0 4px;
    color: #999;
    font-size: 0.875rem;
  }

  /* Mobil: ascunde numerele din mijloc, pastreaza doar ±2 de la curent */
  @media (max-width: 480px) {
    .page-link:not(.page-edge):not(.page-arrow):not(.active) {
      display: none;
    }
    /* Arata maxim 2 inainte si 2 dupa pagina curenta */
    .page-link.active ~ .page-link:nth-of-type(n+4):not(.page-arrow):not(.page-edge) {
      display: none;
    }
  }
</style>
