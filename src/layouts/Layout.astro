---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Stickere from '../components/Stickere.astro';
import { SITE, GA_ID, TRUSTPILOT } from '../data/site.js';
import '../styles/global.css';

const {
  title = `${SITE.nume} — ceasuri, ochelari, bijuterii, încălțăminte și genți cu reduceri`,
  description = SITE.descriere,
  canonical,
  ogImage = '/og-image.png',
  newsletter = true,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, SITE.domeniu).href;
const ogImageURL = new URL(ogImage, SITE.domeniu).href;
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="style.accessories" />
    <meta property="og:locale" content="ro_RO" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
    </script>
    {TRUSTPILOT.businessUnitId && (
      <script is:inline type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <slot />
    {newsletter && <Newsletter />}
    <Footer />
    <CookieBanner />
    <Stickere />

    <script is:inline>
      // affiliate_click — același eveniment ca pe celelalte site-uri (diferențiat după hostname)
      document.addEventListener('click', function (e) {
        var card = e.target.closest('.product-card, .sp-card, .affiliate-cta');
        if (!card || typeof window.gtag !== 'function') return;
        window.gtag('event', 'affiliate_click', {
          item_id: card.dataset.productId,
          item_name: card.dataset.title,
          item_brand: card.dataset.brand,
          value: parseFloat(card.dataset.price) || undefined,
          currency: 'RON',
        });
      });
      // Puls de atenție pe butoanele de categorie (ca la shop)
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var chips = document.querySelectorAll('.filter-chip');
        if (!chips.length) return;
        var last = -1;
        setTimeout(function loop() {
          var i; do { i = Math.floor(Math.random() * chips.length); } while (chips.length > 1 && i === last);
          last = i; chips[i].classList.add('chip-pulse');
          setTimeout(function () { chips[i].classList.remove('chip-pulse'); }, 1600);
          setTimeout(loop, 4000 + Math.random() * 2000);
        }, 2000);
      })();
    </script>
  </body>
</html>
