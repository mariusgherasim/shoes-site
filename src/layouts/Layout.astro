---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Stickere from '../components/Stickere.astro';
import { SITE, GA_ID, TRUSTPILOT } from '../data/site.js';
import { promotiiActive, promotiiNeexpirate } from '../data/promotii.js';
import { MAGAZINE } from '../scripts/magazine.js';
// numărul de pe tabul „% Promoții": promoțiile scrise + câte un card pe magazin
const nrPromotii = promotiiActive().length + Object.keys(MAGAZINE).length;
// browserul recalculează numărul după data de azi (promoțiile programate apar singure)
const datePromo = JSON.stringify({ m: Object.keys(MAGAZINE).length, p: promotiiNeexpirate().map((p) => [p.incepe || '', p.expira || '']) });
import '../styles/global.css';

const {
  title = `${SITE.nume} — ceasuri, ochelari, bijuterii, încălțăminte și genți cu reduceri`,
  description = SITE.descriere,
  canonical,
  ogImage = '/og-image.png',
  newsletter = true,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, SITE.domeniu).href;
const ogImageURL = new URL(ogImage, SITE.domeniu).href;
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="style.accessories" />
    <meta property="og:locale" content="ro_RO" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet" />

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
    </script>
    {TRUSTPILOT.businessUnitId && (
      <script is:inline type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <!-- Bara Black Friday 2026: apare singură 29 oct – 30 nov (ora României), nu apare pe /black-friday/ -->
    <a class="bf-bar" id="bf-bar" href="/black-friday/" hidden>
      <span id="bf-bar-t">🖤 Black Friday 2026: Otter 3–8 noiembrie · Menzo până la -60% · vezi calendarul reducerilor</span>
      <span class="bf-bar-cta">Vezi →</span>
      <button type="button" class="bf-bar-x" id="bf-bar-x" aria-label="Închide">✕</button>
    </a>
    <script is:inline>
      (function () {
        var b = document.getElementById('bf-bar'), n = new Date();
        if (!b || location.pathname.indexOf('/black-friday/') === 0) return;
        if (n < new Date('2026-10-29T18:00:00+02:00') || n > new Date('2026-11-30T23:59:59+02:00')) return;
        try { if (sessionStorage.getItem('bf-bar') === '0') return; } catch (e) {}
        var t = document.getElementById('bf-bar-t');
        if (n >= new Date('2026-11-03T06:00:00+02:00') && n < new Date('2026-11-06T16:00:00+02:00')) t.textContent = '🖤 Black Friday la Otter: acum, cu valuri Best Deals până vineri · Menzo până la -60%';
        else if (n >= new Date('2026-11-06T16:00:00+02:00') && n <= new Date('2026-11-08T23:59:59+02:00')) t.textContent = '🖤 Black Friday la Otter: reduceri până duminică, 8 noiembrie · Menzo până la -60%';
        else if (n > new Date('2026-11-08T23:59:59+02:00')) t.textContent = '🖤 Black Friday 2026: calendarul reducerilor la pantofi, ceasuri și haine';
        b.hidden = false;
        document.getElementById('bf-bar-x').addEventListener('click', function (e) {
          e.preventDefault(); e.stopPropagation(); b.hidden = true;
          try { sessionStorage.setItem('bf-bar', '0'); } catch (x) {}
        });
      })();
    </script>
    <Header />
    <slot />
    {newsletter && <Newsletter />}
    <Footer />
    <CookieBanner />
    <Stickere />
    <a class="pr-tab" id="pr-tab" href="/promotii/" data-promo={datePromo} aria-label={`Promoții și coduri de reducere (${nrPromotii})`}>
      <span class="pr-tab-pct">%</span>
      <span class="pr-tab-txt">Promoții</span>
      <span class="pr-tab-nr">{nrPromotii}</span>
    </a>
    <script is:inline>
      // Pe pagina de promoții: fără tab și fără stickere peste carduri
      if (location.pathname.indexOf('/promotii/') === 0) document.documentElement.classList.add('pe-promotii');
      (function () {
        var t = document.getElementById('pr-tab'); if (!t || !t.dataset.promo) return;
        try {
          var d = JSON.parse(t.dataset.promo), azi = new Date(Date.now() + 2 * 3600e3).toISOString().slice(0, 10);
          var n = d.m + d.p.filter(function (x) { return (!x[0] || x[0] <= azi) && (!x[1] || x[1] >= azi); }).length;
          t.querySelector('.pr-tab-nr').textContent = n;
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      // affiliate_click — același eveniment ca pe celelalte site-uri (diferențiat după hostname)
      document.addEventListener('click', function (e) {
        var card = e.target.closest('.product-card, .sp-card, .affiliate-cta');
        if (!card || typeof window.gtag !== 'function') return;
        window.gtag('event', 'affiliate_click', {
          item_id: card.dataset.productId,
          item_name: card.dataset.title,
          item_brand: card.dataset.brand,
          value: parseFloat(card.dataset.price) || undefined,
          currency: 'RON',
        });
      });
      // Puls de atenție pe butoanele de categorie (ca la shop)
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var chips = document.querySelectorAll('.filter-chip');
        if (!chips.length) return;
        var last = -1;
        setTimeout(function loop() {
          var i; do { i = Math.floor(Math.random() * chips.length); } while (chips.length > 1 && i === last);
          last = i; chips[i].classList.add('chip-pulse');
          setTimeout(function () { chips[i].classList.remove('chip-pulse'); }, 1600);
          setTimeout(loop, 4000 + Math.random() * 2000);
        }, 2000);
      })();
    </script>
  </body>
</html>
